      {
        "annotations": {
          "title": "Search Dataset",
          "readOnlyHint": true,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "description": "Search a Bright Data dataset by a filter and get matching records back directly (fast Elasticsearch-backed search; no snapshot). Use this to FIND MANY records by criteria, as opposed to run_scraper which collects fresh records by URL.\nFirst call list_dataset_fields to get valid field names.\nA filter is a tree: a group {operator:\"and\"|\"or\", filters:[...]} or a leaf {name, value, operator}. Max nesting depth 3.\nLeaf operators: =, !=, <, <=, >, >=, in, not_in, includes, not_includes, array_includes, not_array_includes, is_null, is_not_null.\nSupported dataset_id values:\n- gd_l1viktl72bvl7bjuj0: LinkedIn people profiles\n- gd_me5ppxjr2ge6icjuh0: LinkedIn people profiles (contact-enriched)\n- gd_l1vikfnt1wgvvqz95w: LinkedIn company information",
        "inputSchema": {
          "type": "object",
          "properties": {
            "dataset_id": {
              "type": "string",
              "enum": [
                "gd_l1viktl72bvl7bjuj0",
                "gd_me5ppxjr2ge6icjuh0",
                "gd_l1vikfnt1wgvvqz95w"
              ]
            },
            "filter": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "operator": {
                      "type": "string",
                      "enum": [
                        "and",
                        "or"
                      ]
                    },
                    "filters": {
                      "type": "array",
                      "items": {
                        "anyOf": [
                          {
                            "type": "object",
                            "properties": {
                              "operator": {
                                "type": "string",
                                "enum": [
                                  "and",
                                  "or"
                                ]
                              },
                              "filters": {
                                "type": "array",
                                "items": {
                                  "anyOf": [
                                    {
                                      "type": "object",
                                      "properties": {
                                        "operator": {
                                          "type": "string",
                                          "enum": [
                                            "and",
                                            "or"
                                          ]
                                        },
                                        "filters": {
                                          "type": "array",
                                          "items": {
                                            "type": "object",
                                            "properties": {
                                              "name": {
                                                "type": "string",
                                                "description": "Field name to filter on. Get valid field names from the list_dataset_fields tool."
                                              },
                                              "operator": {
                                                "type": "string",
                                                "description": "Filter operator, one of: =, !=, <, <=, >, >=, in, not_in, includes, not_includes, array_includes, not_array_includes, is_null, is_not_null"
                                              },
                                              "value": {
                                                "anyOf": [
                                                  {
                                                    "type": "string"
                                                  },
                                                  {
                                                    "type": "number"
                                                  },
                                                  {
                                                    "type": "boolean"
                                                  },
                                                  {
                                                    "type": "array",
                                                    "items": {
                                                      "type": [
                                                        "string",
                                                        "number",
                                                        "boolean"
                                                      ]
                                                    }
                                                  }
                                                ],
                                                "description": "Value to compare against. Omit for is_null / is_not_null."
                                              }
                                            },
                                            "required": [
                                              "name",
                                              "operator"
                                            ],
                                            "additionalProperties": false
                                          },
                                          "minItems": 1
                                        }
                                      },
                                      "required": [
                                        "operator",
                                        "filters"
                                      ],
                                      "additionalProperties": false
                                    },
                                    {
                                      "$ref": "#/properties/filter/anyOf/0/properties/filters/items/anyOf/0/properties/filters/items/anyOf/0/properties/filters/items"
                                    }
                                  ]
                                },
                                "minItems": 1
                              }
                            },
                            "required": [
                              "operator",
                              "filters"
                            ],
                            "additionalProperties": false
                          },
                          {
                            "$ref": "#/properties/filter/anyOf/0/properties/filters/items/anyOf/0/properties/filters/items/anyOf/0/properties/filters/items"
                          }
                        ]
                      },
                      "minItems": 1
                    }
                  },
                  "required": [
                    "operator",
                    "filters"
                  ],
                  "additionalProperties": false
                },
                {
                  "$ref": "#/properties/filter/anyOf/0/properties/filters/items/anyOf/0/properties/filters/items/anyOf/0/properties/filters/items"
                }
              ],
              "description": "Filter tree describing which records to match. Required, cannot be empty."
            },
            "size": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 10,
              "default": 10,
              "description": "Number of records to return (max 10, default 10)"
            },
            "sort": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "default",
                    "random"
                  ]
                },
                {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string",
                      "enum": [
                        "asc",
                        "desc"
                      ]
                    }
                  }
                }
              ],
              "description": "Sorting: \"default\", \"random\", or a custom array like [{\"timestamp\":\"asc\"}]. Use \"default\" or custom sort to paginate with search_after."
            },
            "search_after": {
              "type": "array",
              "description": "Pagination cursor from a previous response's search_after value."
            }
          },
          "required": [
            "dataset_id",
            "filter"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "name": "search_dataset"
